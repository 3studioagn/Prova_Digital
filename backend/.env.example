# =============================================================================
# Rastreio de Provas Digitais - Variaveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o .env com valores reais.
# =============================================================================

# --- Supabase ---
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
SUPABASE_JWT_SECRET=sua-jwt-secret-aqui

# --- PostgreSQL (via pooler do Supabase) ---
DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[senha]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=seu-account-id
R2_ACCESS_KEY_ID=seu-access-key-id
R2_SECRET_ACCESS_KEY=seu-secret-access-key
R2_BUCKET_NAME=rastreio-provas-artes
R2_ENDPOINT_URL=https://seu-account-id.r2.cloudflarestorage.com

# --- Aplicacao ---
APP_ENV=development
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
