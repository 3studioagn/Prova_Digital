# =============================================================================
# Frontend env vars — copy this file to .env.local and fill in real values
# =============================================================================
# All vars MUST start with NEXT_PUBLIC_ to be exposed to the browser.
# Anything that should NEVER reach the browser (service role key, R2 secrets,
# JWT secret) belongs in backend/.env, NOT here.
#
# .env.local is git-ignored. .env.local.example is committed as a template.
# =============================================================================


# ── Supabase (public anon credentials, safe to ship to the browser) ──────────
# Project URL — find it in Supabase dashboard > Project Settings > API.
# The current production project is rwxlpwmnkekzuurgthkr (sa-east-1).
NEXT_PUBLIC_SUPABASE_URL=https://rwxlpwmnkekzuurgthkr.supabase.co

# Anon (public) key — JWT with role=anon. Used by @supabase/ssr to talk to
# auth.users from the browser. NEVER paste the service_role key here — that
# bypasses RLS and would give every browser full DB access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-dashboard


# ── Backend API ──────────────────────────────────────────────────────────────
# Base URL the frontend uses to call FastAPI. The frontend forwards the user's
# Supabase JWT in the Authorization header — the backend verifies it via JWKS.
# Local dev:    http://localhost:8000
# Staging/prod: https://<your-railway-domain>
NEXT_PUBLIC_API_URL=http://localhost:8000
